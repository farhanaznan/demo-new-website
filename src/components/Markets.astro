---
import { links, markets } from '../content/site';
import BrandWatermark from './BrandWatermark.astro';
import Logo from './Logo.astro';

const icons: Record<string, string> = {
  forex: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>`,
  indices: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 19V5M4 19h16"/><path d="m7 14 4-4 3 3 5-6"/></svg>`,
  metals: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3 4 8v8l8 5 8-5V8l-8-5Z"/><path d="M12 12 4 8m8 4 8-4M12 12v9"/></svg>`,
  energies: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 21h8M9 21V9a3 3 0 0 1 6 0v12"/><path d="M9 11h6M9 15h6"/><path d="M12 3v3"/></svg>`,
  crypto: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M10 8h5.5a2.5 2.5 0 0 1 0 5H10zm0 5h6a2.5 2.5 0 0 1 0 5H10zM11 7v10M14 7v10"/></svg>`,
  shares: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 16V10M12 16V8M16 16v-4"/></svg>`,
};
---

<section id="markets" class="markets-orbit relative overflow-hidden">
  <div class="absolute inset-0 bg-[#06172D]"></div>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.18] [background-image:linear-gradient(rgba(22,139,255,0.35)_1px,transparent_1px),linear-gradient(90deg,rgba(22,139,255,0.35)_1px,transparent_1px)] [background-size:40px_40px] [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_75%)]"
    aria-hidden="true"
  >
  </div>
  <div class="hatch-overlay-dark pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute left-1/2 top-[42%] h-[28rem] w-[28rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(22,139,255,0.26)_0%,transparent_65%)] sm:h-[42rem] sm:w-[42rem]"
    aria-hidden="true"
  >
  </div>
  <BrandWatermark class="left-[-18%] top-10 opacity-[0.08] sm:left-0" />
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-[#08111F]/80 to-transparent sm:h-40"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-12 text-center sm:px-8 sm:py-20 lg:py-32">
    <div class="mx-auto mb-5 flex justify-center sm:mb-7">
      <Logo tone="on-dark" class="h-14 w-auto sm:h-20" />
    </div>
    <p class="tech-kicker justify-center">Markets · all-asset engine</p>
    <h2 class="mt-3 font-display text-[1.75rem] font-bold tracking-tight text-white sm:mt-4 sm:text-5xl lg:text-7xl">
      Trade all markets.<br />Boundless opportunity.
    </h2>
    <p class="mx-auto mt-4 max-w-3xl text-sm leading-relaxed text-white/70 sm:mt-5 sm:text-xl">
      Trade Forex, metals, indices, shares, energies, crypto and more in one powerful ecosystem —
      with institutional-grade conditions and lightning-fast execution.
    </p>
    <div class="mt-7 flex w-full flex-col items-center justify-center gap-3 sm:mt-8 sm:w-auto sm:flex-row">
      <a href={links.register} class="btn-primary btn-magnetic w-full px-8 py-4 text-base sm:w-auto">
        Start Trading Now
      </a>
      <a
        href="/markets"
        class="btn-secondary btn-magnetic w-full border-white/25 bg-transparent px-8 py-4 text-base text-white hover:border-white hover:text-white sm:w-auto"
      >
        Explore All Markets
      </a>
    </div>
    <div class="market-orbit-stage relative mx-auto mt-10 max-w-5xl sm:mt-16">
      <div
        class="pointer-events-none absolute left-1/2 top-[38%] hidden h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full border border-signal/25 sm:block sm:h-[22rem] sm:w-[22rem]"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute left-1/2 top-[38%] hidden h-52 w-52 -translate-x-1/2 -translate-y-1/2 rounded-full bg-signal/10 blur-2xl sm:block sm:h-72 sm:w-72"
        aria-hidden="true"
      >
      </div>

      <div
        class="market-orbit-row relative z-10 grid grid-cols-3 items-end justify-items-center gap-x-2 gap-y-4 sm:flex sm:justify-center sm:gap-5 md:gap-7"
        role="tablist"
        aria-label="Market categories"
      >
        {
          markets.map((market, index) => (
            <button
              type="button"
              role="tab"
              class="market-orbit-btn group relative flex flex-col items-center gap-1.5 sm:gap-2"
              data-market-tab={index}
              aria-label={market.title}
              aria-selected={index === 2 ? 'true' : 'false'}
              aria-controls="market-orbit-panel"
              id={`market-tab-${index}`}
            >
              <span
                class="market-orbit-icon grid place-items-center border border-white/15 bg-[#0b2545] text-white/80 shadow-[0_0_0_0_rgba(22,139,255,0)] transition duration-300"
                set:html={icons[market.id]}
              />
              <span class="market-orbit-name font-mono text-[9px] uppercase tracking-[0.12em] text-white/70 sm:text-xs">
                {market.title}
              </span>
            </button>
          ))
        }
      </div>

      <div
        id="market-orbit-panel"
        role="tabpanel"
        aria-labelledby="market-tab-2"
        class="relative z-10 mt-6 border border-white/10 bg-white/[0.04] px-3 py-4 sm:mt-12 sm:px-6 sm:py-6"
      >
        <p
          class="market-orbit-label inline-flex border border-white/15 bg-white/10 px-4 py-2 font-display text-lg font-bold tracking-wide text-white backdrop-blur sm:px-6 sm:py-2.5 sm:text-2xl"
          data-market-label
        >
          {markets[2].title}
        </p>
        <p class="market-orbit-sub mt-3 font-mono text-[10px] uppercase tracking-[0.18em] text-signal sm:mt-4 sm:text-sm" data-market-sub>
          {markets[2].subtitle}
        </p>
        <p class="market-orbit-copy mx-auto mt-3 max-w-xl text-sm leading-relaxed text-white/70 sm:mt-4 sm:text-lg" data-market-copy>
          {markets[2].detail}
        </p>
        <ul class="mt-3 flex flex-wrap justify-center gap-2 sm:mt-4" data-market-points>
          {
            markets[2].points.map((point) => (
              <li class="border border-white/10 bg-white/5 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.08em] text-white/75 sm:px-4 sm:text-sm sm:normal-case sm:tracking-normal">
                {point}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .market-orbit-icon {
    width: 3.35rem;
    height: 3.35rem;
  }

  .market-orbit-icon :global(svg) {
    width: 1.45rem;
    height: 1.45rem;
  }

  .market-orbit-btn.is-active .market-orbit-icon {
    width: 4.15rem;
    height: 4.15rem;
    color: white;
    border-color: rgba(22, 139, 255, 0.65);
    background: linear-gradient(160deg, #168bff, #0b2545 55%, #08111f);
    box-shadow:
      0 0 0 8px rgba(22, 139, 255, 0.12),
      0 0 36px rgba(22, 139, 255, 0.4);
  }

  .market-orbit-btn.is-active .market-orbit-icon :global(svg) {
    width: 1.85rem;
    height: 1.85rem;
  }

  .market-orbit-btn.is-active .market-orbit-name {
    color: white;
  }

  .market-orbit-btn:not(.is-active) {
    opacity: 0.7;
  }

  .market-orbit-btn:not(.is-active):hover {
    opacity: 1;
  }

  @media (min-width: 640px) {
    .market-orbit-icon {
      width: 5rem;
      height: 5rem;
    }

    .market-orbit-icon :global(svg) {
      width: 2.15rem;
      height: 2.15rem;
    }

    .market-orbit-btn.is-active .market-orbit-icon {
      width: 7rem;
      height: 7rem;
    }

    .market-orbit-btn.is-active .market-orbit-icon :global(svg) {
      width: 3rem;
      height: 3rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { markets } from '../content/site';

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-market-tab]'));
  const label = document.querySelector<HTMLElement>('[data-market-label]');
  const sub = document.querySelector<HTMLElement>('[data-market-sub]');
  const copy = document.querySelector<HTMLElement>('[data-market-copy]');
  const points = document.querySelector<HTMLElement>('[data-market-points]');
  const panel = document.getElementById('market-orbit-panel');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let active = 2;
  let timer: number | undefined;

  const renderPoints = (items: readonly string[]) => {
    if (!points) return;
    points.innerHTML = items
      .map(
        (point) =>
          `<li class="border border-white/10 bg-white/5 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.08em] text-white/75 sm:px-4 sm:text-sm sm:normal-case sm:tracking-normal">${point}</li>`,
      )
      .join('');
  };

  const setActive = (index: number, animate = true) => {
    active = (index + markets.length) % markets.length;
    const market = markets[active];

    tabs.forEach((tab, i) => {
      const on = i === active;
      tab.classList.toggle('is-active', on);
      tab.setAttribute('aria-selected', String(on));
    });

    if (panel) panel.setAttribute('aria-labelledby', `market-tab-${active}`);

    const updateText = () => {
      if (label) label.textContent = market.title;
      if (sub) sub.textContent = market.subtitle;
      if (copy) copy.textContent = market.detail;
      renderPoints(market.points);
    };

    if (!animate || reduceMotion) {
      updateText();
      return;
    }

    const targets = [label, sub, copy, points].filter(Boolean);
    gsap.to(targets, {
      opacity: 0,
      y: 8,
      duration: 0.18,
      ease: 'power2.in',
      onComplete: () => {
        updateText();
        gsap.fromTo(
          targets,
          { opacity: 0, y: -8 },
          { opacity: 1, y: 0, duration: 0.28, ease: 'power2.out', stagger: 0.04 },
        );
      },
    });

    const activeBtn = tabs[active]?.querySelector('.market-orbit-icon');
    if (activeBtn) {
      gsap.fromTo(
        activeBtn,
        { scale: 0.86 },
        { scale: 1, duration: 0.45, ease: 'back.out(1.6)' },
      );
    }
  };

  const start = () => {
    window.clearInterval(timer);
    if (reduceMotion) return;
    timer = window.setInterval(() => setActive(active + 1), 3200);
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => {
      setActive(index);
      start();
    });
    tab.addEventListener('pointerenter', () => {
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      setActive(index);
      window.clearInterval(timer);
    });
    tab.addEventListener('pointerleave', () => start());
  });

  setActive(2, false);
  start();
</script>
