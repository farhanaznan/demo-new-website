---
interface Props {
  tone?: 'on-light' | 'on-dark';
  class?: string;
}

const { tone = 'on-dark', class: className = '' } = Astro.props;
const src =
  tone === 'on-dark'
    ? '/brand/infinite-on-dark-mark.png'
    : '/brand/infinite-mark-on-light.png';
---

<img
  src={src}
  alt=""
  width="640"
  height="276"
  class:list={['brand-watermark pointer-events-none select-none', className]}
  aria-hidden="true"
  decoding="async"
/>
