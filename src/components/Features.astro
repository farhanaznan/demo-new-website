---
import { features, links } from '../content/site';
import BrandWatermark from './BrandWatermark.astro';

const icons: Record<(typeof features)[number]['id'], string> = {
  withdrawals: `<path d="M12 3v12m0 0-4-4m4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 18h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>`,
  'swap-free': `<path d="M4 8h12l-2.5-3M20 16H8l2.5 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="18" cy="8" r="1.6" fill="currentColor"/><circle cx="6" cy="16" r="1.6" fill="currentColor"/>`,
  support: `<path d="M5 11a7 7 0 0 1 14 0v2.5a2.5 2.5 0 0 1-2.5 2.5H15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M9 18.5a3 3 0 0 0 6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><rect x="3.5" y="10" width="3.5" height="6" rx="1.2" stroke="currentColor" stroke-width="1.8"/><rect x="17" y="10" width="3.5" height="6" rx="1.2" stroke="currentColor" stroke-width="1.8"/>`,
  execution: `<path d="M13 3 5.5 13.5H12l-1 7.5L18.5 10H12L13 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>`,
  spreads: `<path d="M4 16.5 9.5 9l4 4L20 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 5.5h5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>`,
  security: `<path d="M12 3.5 5.5 6.5v5.2c0 4.1 2.8 7.5 6.5 8.8 3.7-1.3 6.5-4.7 6.5-8.8V6.5L12 3.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m9.5 12 1.7 1.7 3.3-3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>`,
};
---

<section id="about" class="features-band relative overflow-hidden section-pad">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute inset-0 bg-[radial-gradient(900px_480px_at_12%_0%,rgba(22,139,255,0.22),transparent_55%),radial-gradient(700px_420px_at_88%_20%,rgba(11,37,69,0.35),transparent_50%),linear-gradient(180deg,#06172D_0%,#0B2545_48%,#08111F_100%)]"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.14] [background-image:linear-gradient(rgba(245,250,252,0.12)_1px,transparent_1px),linear-gradient(90deg,rgba(245,250,252,0.12)_1px,transparent_1px)] [background-size:56px_56px] [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_78%)]"
    >
    </div>
    <BrandWatermark class="right-[-12%] top-8 hidden rotate-12 sm:block lg:right-0" />
  </div>

  <div class="container-shell relative">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="section-intro max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-signal">Empower traders</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-5xl lg:text-[3.4rem] lg:leading-[1.05]">
          An exceptional trading environment
        </h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-white/65 sm:text-lg">
          Everything you need for disciplined execution — speed, transparency, and support that stays
          with you through every session.
        </p>
      </div>
      <a
        href={links.register}
        class="btn-primary btn-magnetic w-full shrink-0 sm:w-auto"
      >
        Open Live Account
      </a>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
      {
        features.map((feature, index) => (
          <article
            data-spotlight
            class="feature-card spotlight-card group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.06] p-5 backdrop-blur-sm transition duration-300 hover:-translate-y-2 hover:border-signal/45 hover:bg-white/[0.1] hover:shadow-[0_28px_60px_rgba(0,0,0,0.35)] sm:p-8"
          >
            <div class="mb-6 flex items-start justify-between gap-4">
              <div class="grid h-12 w-12 place-items-center rounded-xl bg-signal/15 text-signal ring-1 ring-signal/25 transition duration-300 group-hover:bg-signal group-hover:text-white group-hover:ring-signal">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <Fragment set:html={icons[feature.id]} />
                </svg>
              </div>
              <span class="font-display text-sm font-bold tabular-nums text-white/25 transition group-hover:text-signal">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <h3 class="font-display text-xl font-bold tracking-tight text-white sm:text-2xl">{feature.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-white/60">{feature.copy}</p>
            <div class="mt-6 h-px w-full origin-left scale-x-40 bg-gradient-to-r from-signal to-transparent transition duration-300 group-hover:scale-x-100" />
          </article>
        ))
      }
    </div>
  </div>
</section>
