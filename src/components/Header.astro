---
import { links, nav } from '../content/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href.startsWith('/#')) return false;
  return path === href || path.startsWith(`${href}/`);
};
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent pt-[env(safe-area-inset-top)] transition-[background,border,box-shadow] duration-300"
>
  <div class="container-shell flex h-16 items-center justify-between gap-3 sm:h-[4.5rem] sm:gap-4">
    <a href="/" class="group flex min-w-0 shrink items-center" aria-label="Infinite home">
      <Logo variant="pill" class="h-9 w-auto sm:h-11" />
    </a>

    <nav class="hidden items-center gap-6 xl:gap-7 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link text-ink-soft/80 transition hover:text-ocean',
              isActive(item.href) ? 'is-active' : '',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <span
        class="hidden items-center gap-2 border border-line bg-white/70 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-muted md:inline-flex"
      >
        <span class="live-dot h-1.5 w-1.5 rounded-full bg-signal"></span>
        Sys.online
      </span>
      <a href={links.login} class="btn-secondary hidden px-4 py-2.5 lg:inline-flex">Log In</a>
      <a href={links.register} class="btn-primary hidden px-4 py-2.5 lg:inline-flex">Sign Up</a>
      <button
        id="nav-toggle"
        type="button"
        class="relative z-10 inline-flex h-10 w-10 shrink-0 items-center justify-center border border-line bg-white/85 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span class="sr-only">Menu</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-line bg-[#0b2545] lg:!hidden">
    <nav class="container-shell flex flex-col gap-1 py-3" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'border border-transparent px-3 py-3 font-mono text-xs uppercase tracking-[0.18em] text-white/80 hover:border-signal/40 hover:bg-white/5 hover:text-white',
              isActive(item.href) ? 'border-signal/40 bg-white/5 text-white' : '',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={links.login}
        class="px-3 py-3 font-mono text-xs uppercase tracking-[0.18em] text-white/80 hover:text-white"
        >Log In</a
      >
      <a href={links.register} class="btn-primary mt-2 w-full">Sign Up</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  const onScroll = () => {
    if (!header) return;
    const scrolled = window.scrollY > 12;
    header.classList.toggle('border-line/80', scrolled);
    header.classList.toggle('bg-white/90', scrolled);
    header.classList.toggle('shadow-[0_8px_30px_rgba(7,24,34,0.08)]', scrolled);
    header.classList.toggle('backdrop-blur-md', scrolled);
  };

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
