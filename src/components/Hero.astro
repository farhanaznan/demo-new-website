---
import { brand, links } from '../content/site';
import Logo from './Logo.astro';
---

<section class="hero-stage relative overflow-hidden pt-[calc(4rem+env(safe-area-inset-top))] sm:pt-[calc(4.5rem+env(safe-area-inset-top))] lg:min-h-[100svh]">
  <div class="absolute inset-0 -z-10">
    <div
      class="absolute inset-0 bg-[linear-gradient(165deg,#d5dee8_0%,#eef2f6_38%,#c5d0dc_100%)]"
    >
    </div>
    <div class="hatch-overlay pointer-events-none absolute inset-0 opacity-80" aria-hidden="true"></div>
    <div class="hero-grid pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-signal/70 to-transparent"
      aria-hidden="true"
    >
    </div>
    <svg
      class="pointer-events-none absolute inset-x-0 bottom-0 h-[42%] w-full opacity-50"
      viewBox="0 0 1440 420"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M0 260 180 210 320 240 480 160 640 200 820 120 980 170 1140 90 1440 140V420H0V260Z"
        stroke="#0B2545"
        stroke-opacity="0.28"
        stroke-width="1.5"
        fill="url(#heroFill)"
      >
      </path>
      <path
        class="hero-wave"
        d="M0 220 200 170 360 200 540 130 720 180 920 100 1120 150 1440 80"
        stroke="#168BFF"
        stroke-opacity="0.55"
        stroke-width="2"
      >
      </path>
      <defs>
        <linearGradient id="heroFill" x1="720" y1="80" x2="720" y2="420" gradientUnits="userSpaceOnUse">
          <stop stop-color="#06172D" stop-opacity="0.16"></stop>
          <stop offset="1" stop-color="#06172D" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
    </svg>
  </div>

  <div
    class="container-shell relative flex flex-col justify-center py-10 lg:min-h-[calc(100svh-4.5rem)] lg:py-20"
  >
    <div class="max-w-3xl">
      <p class="hero-kicker tech-kicker">
        <span class="live-dot h-1.5 w-1.5 rounded-full bg-signal"></span>
        Engine online · latency &lt;10ms
      </p>
      <div class="hero-brand mt-4 w-[min(100%,14.5rem)] sm:w-[min(100%,18rem)] lg:w-[min(100%,22rem)]">
        <Logo tone="on-light" class="h-auto w-full" />
      </div>
      <h1 class="hero-title mt-5 font-display text-[1.75rem] font-bold leading-[1.1] tracking-tight text-ink sm:mt-6 sm:text-5xl lg:text-6xl">
        Trade Better.<br />Build a Brighter Future.
      </h1>
      <p class="hero-copy mt-4 max-w-xl text-sm leading-relaxed text-ink-soft/80 sm:mt-5 sm:text-lg">
        {brand.description}
      </p>
      <div class="hero-cta mt-7 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:flex-wrap">
        <a href={links.register} class="btn-primary btn-magnetic">Start Trading</a>
        <a href={links.login} class="btn-secondary btn-magnetic">Log In</a>
      </div>
    </div>

    <div class="hero-visual-mobile mt-8 lg:hidden">
      <div class="mech-panel-dark mech-corners relative overflow-hidden p-4 text-white">
        <div class="scanlines-dark pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
        <div class="relative">
          <div class="flex items-center justify-between gap-3">
            <Logo tone="on-dark" class="h-9 w-auto" />
            <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-white/70">
              <span class="live-dot h-1.5 w-1.5 rounded-full bg-signal"></span>
              Live feed
            </span>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-2 text-sm">
            <div class="border border-white/15 bg-white/5 p-3">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-white/55">EURUSD</p>
              <p
                class="ticker mt-1 font-semibold tabular-nums"
                data-ticker
                data-base="1.0842"
                data-decimals="4"
                data-variance="0.0012"
              >
                1.0842
              </p>
            </div>
            <div class="border border-white/15 bg-white/5 p-3">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-white/55">XAUUSD</p>
              <p
                class="ticker mt-1 font-semibold tabular-nums"
                data-ticker
                data-base="2341.60"
                data-decimals="2"
                data-variance="1.8"
              >
                2341.60
              </p>
            </div>
          </div>
          <div class="mt-2 grid grid-cols-2 gap-2">
            <div class="border border-white/15 bg-white/5 px-3 py-2">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-white/55">Spread</p>
              <p class="font-display text-lg font-bold">0.0</p>
            </div>
            <div class="border border-white/15 bg-white/5 px-3 py-2">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-white/55">Leverage</p>
              <p class="font-display text-lg font-bold">1:3000</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="hero-visual absolute right-0 top-1/2 hidden w-[42%] -translate-y-1/2 perspective-[1200px] lg:block"
      aria-hidden="true"
    >
      <div class="hero-visual-inner relative aspect-square max-w-md transform-gpu xl:max-w-lg">
        <div class="absolute inset-[8%] border border-ocean/20 bg-white/35 backdrop-blur-md"></div>
        <div
          class="absolute inset-[18%] bg-gradient-to-br from-[#06172D] via-[#0B2545] to-signal opacity-95"
        >
        </div>
        <div class="absolute inset-[26%] border border-white/20 bg-ink/35 p-5 text-white">
          <div class="scanlines-dark pointer-events-none absolute inset-0 opacity-50"></div>
          <div class="relative flex items-center justify-between gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-white/70">
            <Logo tone="on-dark" class="h-8 w-auto" />
            <span class="inline-flex items-center gap-2">
              <span class="live-dot h-1.5 w-1.5 rounded-full bg-signal"></span>
              Live markets
            </span>
          </div>
          <div class="relative mt-6 space-y-3">
            <div class="h-1.5 w-full overflow-hidden bg-white/15">
              <div class="meter-bar h-1.5 w-4/5 bg-signal"></div>
            </div>
            <div class="h-1.5 w-full overflow-hidden bg-white/15">
              <div class="meter-bar h-1.5 w-3/5 bg-white/70"></div>
            </div>
            <div class="h-1.5 w-full overflow-hidden bg-white/15">
              <div class="meter-bar h-1.5 w-2/3 bg-signal/70"></div>
            </div>
          </div>
          <div class="relative mt-8 grid grid-cols-2 gap-3 text-xs">
            <div class="border border-white/15 bg-white/10 p-3">
              <p class="font-mono text-white/55">EURUSD</p>
              <p
                class="ticker mt-1 font-semibold tabular-nums"
                data-ticker
                data-base="1.0842"
                data-decimals="4"
                data-variance="0.0012"
              >
                1.0842
              </p>
            </div>
            <div class="border border-white/15 bg-white/10 p-3">
              <p class="font-mono text-white/55">XAUUSD</p>
              <p
                class="ticker mt-1 font-semibold tabular-nums"
                data-ticker
                data-base="2341.60"
                data-decimals="2"
                data-variance="1.8"
              >
                2341.60
              </p>
            </div>
          </div>
        </div>
        <div
          class="float-chip absolute -left-4 top-16 border border-line bg-white/95 px-4 py-3 shadow-lg"
        >
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">Spread</p>
          <p class="font-display text-xl font-bold text-ocean">0.0</p>
        </div>
        <div
          class="float-chip absolute -right-2 bottom-20 border border-line bg-white/95 px-4 py-3 shadow-lg"
        >
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">Leverage</p>
          <p class="font-display text-xl font-bold text-ocean">1:3000</p>
        </div>
      </div>
    </div>
  </div>
</section>
