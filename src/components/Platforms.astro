---
import { links, platforms } from '../content/site';
import Logo from './Logo.astro';
---

<section id="platforms" class="section-pad pt-0">
  <div class="container-shell">
    <div class="section-intro max-w-2xl">
      <p class="eyebrow">Platforms</p>
      <h2 class="headline mt-3">Trading platforms built for your success</h2>
      <p class="lede mt-4">
        Access powerful tools for analysis, execution, and portfolio control — desktop, web, and
        mobile.
      </p>
    </div>

    <div class="mt-8 grid gap-3 sm:mt-12 sm:gap-5 lg:grid-cols-3">
      {
        platforms.map((platform) => (
          <article
            data-spotlight
            class="platform-card spotlight-card group relative overflow-hidden border border-line bg-gradient-to-b from-white to-mist/60 p-4 transition duration-300 hover:-translate-y-1.5 hover:border-ocean/30 hover:shadow-[0_20px_45px_rgba(7,24,34,0.1)] sm:p-7"
          >
            <Logo
              variant="mark"
              tone="on-light"
              decorative
              class="absolute -right-3 -top-2 h-12 w-auto opacity-[0.08] transition duration-300 group-hover:opacity-20"
            />
            <span class="border border-ocean/15 bg-ocean/10 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-ocean transition group-hover:border-ocean group-hover:bg-ocean group-hover:text-white">
              {platform.badge}
            </span>
            <h3 class="mt-3 font-display text-xl font-bold text-ink sm:mt-4 sm:text-2xl">{platform.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted sm:mt-3">{platform.copy}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-6 sm:mt-8">
      <a href={links.register} class="btn-secondary btn-magnetic w-full sm:w-auto">View Trading Platforms</a>
    </div>
  </div>
</section>
