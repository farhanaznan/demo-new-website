---
import { seaCustomers } from '../content/site';

const rowA = [...seaCustomers];
const rowB = [...seaCustomers].reverse();
---

<section id="customers" class="sea-customers relative overflow-hidden">
  <div class="hatch-overlay pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div class="container-shell relative py-10 sm:py-16 lg:py-20">
    <div class="section-intro mech-panel mech-corners px-4 py-5 sm:px-8 sm:py-8">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="eyebrow">Our community</p>
        <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-steel">Sector · ASEAN</p>
      </div>
      <h2 class="headline mt-2 sm:mt-3">Trusted by traders across Southeast Asia</h2>
      <p class="lede mt-3 sm:mt-4">
        Across Indonesia, Thailand, Vietnam, the Philippines, and the rest of ASEAN — Infinite powers
        traders with local payment rails and 24/7 support.
      </p>
      <div class="mt-5 grid grid-cols-2 gap-2 sm:mt-6 sm:flex sm:flex-wrap sm:gap-3">
        <div class="flex items-center gap-2 border border-line bg-white/90 px-3 py-2 text-xs text-ink-soft sm:text-sm">
          <span class="live-dot h-2 w-2 rounded-full bg-signal"></span>
          <span
            ><strong class="text-ink" data-count="10" data-suffix=" markets">0 markets</strong></span
          >
        </div>
        <div class="flex items-center gap-2 border border-line bg-white/90 px-3 py-2 text-xs text-ink-soft sm:text-sm">
          <strong class="text-ink" data-count="36" data-suffix="K+ traders">0K+ traders</strong>
        </div>
      </div>
    </div>

    <!-- Desktop/tablet marquee only — hidden on phones to avoid empty horizontal tracks -->
    <div class="sea-marquee-wrap relative mt-6 hidden space-y-3 sm:mt-8 sm:block" aria-hidden="true">
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-paper to-transparent sm:w-28">
      </div>
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-paper to-transparent sm:w-28">
      </div>

      <div class="sea-marquee sea-marquee--left overflow-hidden">
        <div class="sea-marquee-track flex w-max flex-nowrap gap-3">
          {
            [...rowA, ...rowA].map((country) => (
              <div class="sea-chip flex items-center gap-3 border border-line bg-white/90 px-4 py-2.5 shadow-[0_10px_30px_rgba(7,24,34,0.06)]">
                <img
                  src={`/images/flags/${country.code}.svg`}
                  alt=""
                  width="40"
                  height="28"
                  class="h-6 w-9 rounded-sm object-cover shadow-sm ring-1 ring-black/5"
                  loading="lazy"
                />
                <p class="text-sm font-semibold text-ink">{country.name}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="sea-marquee sea-marquee--right overflow-hidden">
        <div class="sea-marquee-track flex w-max flex-nowrap gap-3">
          {
            [...rowB, ...rowB].map((country) => (
              <div class="sea-chip flex items-center gap-3 border border-line bg-white/90 px-4 py-2.5 shadow-[0_10px_30px_rgba(7,24,34,0.06)]">
                <img
                  src={`/images/flags/${country.code}.svg`}
                  alt=""
                  width="40"
                  height="28"
                  class="h-6 w-9 rounded-sm object-cover shadow-sm ring-1 ring-black/5"
                  loading="lazy"
                />
                <div>
                  <p class="text-sm font-semibold text-ink">{country.name}</p>
                  <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted">
                    {country.traders.toLocaleString()}+ traders
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Compact mobile roster: one row per market, no marquee air gap -->
    <ul class="sea-grid mt-4 grid grid-cols-1 gap-2 sm:mt-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-3" role="list">
      {
        seaCustomers.map((country, index) => (
          <li>
            <button
              type="button"
              class="sea-card group relative flex w-full items-center gap-3 overflow-hidden border border-line bg-white/80 p-2.5 text-left transition duration-300 sm:flex-col sm:items-stretch sm:p-4"
              data-sea-card
              data-index={index}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span class="flex min-w-0 flex-1 items-center gap-3 sm:w-full">
                <span class="relative shrink-0">
                  <img
                    src={`/images/flags/${country.code}.svg`}
                    alt={`${country.name} flag`}
                    width="48"
                    height="32"
                    class="h-7 w-10 rounded-sm object-cover shadow-sm ring-1 ring-black/5 transition duration-300 group-hover:scale-105 sm:h-8 sm:w-12"
                    loading="lazy"
                  />
                  <span class="sea-pulse absolute -right-1 -top-1 h-2 w-2 rounded-full bg-signal ring-2 ring-white sm:h-2.5 sm:w-2.5">
                  </span>
                </span>
                <span class="block min-w-0 truncate font-display text-sm font-bold text-ink sm:text-base">{country.name}</span>
              </span>
              <span class="shrink-0 text-right sm:mt-3 sm:flex sm:w-full sm:items-end sm:justify-between sm:text-left">
                <span class="font-display text-base font-bold tabular-nums text-ocean sm:text-2xl">
                  <span data-sea-count={country.traders}>0</span>
                  <span class="text-sm sm:text-base">+</span>
                </span>
                <span class="hidden font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-muted sm:inline">
                  Active traders
                </span>
              </span>
              <span class="sea-card-bar mt-3 hidden h-1 w-full overflow-hidden bg-mist sm:block">
                <span
                  class="sea-card-fill block h-full origin-left scale-x-0 bg-signal"
                  style={`--fill:${Math.min(100, Math.round((country.traders / 8200) * 100))}%`}
                >
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>

    <p class="sea-active-label mt-4 font-mono text-[11px] uppercase tracking-[0.16em] text-muted sm:mt-6 sm:text-center sm:text-sm sm:normal-case sm:tracking-normal">
      Now featuring traders from
      <strong class="text-ink" data-sea-active-name>Indonesia</strong>
    </p>
  </div>
</section>

<style>
  .sea-marquee-track {
    will-change: transform;
  }

  .sea-card.is-active {
    border-color: color-mix(in oklab, var(--color-signal) 55%, white);
    box-shadow: 0 10px 28px rgba(7, 24, 34, 0.1);
    background: #fff;
  }

  .sea-card-fill {
    width: var(--fill, 70%);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .sea-pulse {
    animation: pulse-dot 1.6s ease-in-out infinite;
  }

  .sea-card:not(.is-active) .sea-pulse {
    opacity: 0.35;
    animation: none;
  }

  @media (min-width: 640px) {
    .sea-card.is-active {
      transform: translateY(-4px);
    }
  }
</style>
