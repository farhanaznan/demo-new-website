---
import { stats } from '../content/site';

type CountMeta = {
  count: number;
  prefix?: string;
  suffix?: string;
  decimals?: number;
  startText: string;
};

const countMeta: Record<string, CountMeta> = {
  '0.0': { count: 0, decimals: 1, startText: '0.0' },
  '1:3000': { count: 3000, prefix: '1:', startText: '1:0' },
  '0.01': { count: 0.01, decimals: 2, startText: '0.00' },
  '60+': { count: 60, suffix: '+', startText: '0+' },
  '24/7': { count: 24, suffix: '/7', startText: '0/7' },
};
---

<section class="relative z-10 -mt-3 sm:-mt-6" aria-label="Key trading conditions">
  <div class="container-shell">
    <div class="surface stats-panel mech-corners px-2 py-3 shadow-[0_20px_50px_rgba(7,24,34,0.08)] sm:px-4 sm:py-4">
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
        {
          stats.map((item, index) => {
            const meta = countMeta[item.value];
            return (
              <li
                class:list={[
                  'stat-item group px-3 py-3 text-center transition duration-300 hover:-translate-y-0.5 sm:text-left',
                  index === stats.length - 1 && 'col-span-2 border-t border-line/80 sm:col-span-1 sm:border-t-0',
                  index > 0 && 'sm:border-l sm:border-line/80',
                  index % 2 === 1 && 'border-l border-line/80 sm:border-l-0 lg:border-l',
                ]}
              >
                <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-steel">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <p
                  class="mt-1 font-display text-2xl font-bold tracking-tight text-ink tabular-nums sm:text-3xl"
                  data-count={meta.count}
                  data-prefix={meta.prefix || ''}
                  data-suffix={meta.suffix || ''}
                  data-decimals={meta.decimals ?? 0}
                >
                  {meta.startText}
                </p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-muted transition group-hover:text-ocean">
                  {item.label}
                </p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
