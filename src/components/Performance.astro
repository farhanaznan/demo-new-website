---
import { links, performance } from '../content/site';
import BrandWatermark from './BrandWatermark.astro';
import Logo from './Logo.astro';

const countMeta: Record<
  string,
  { count: number; prefix?: string; suffix?: string; decimals?: number; startText: string }
> = {
  '1B+': { count: 1, suffix: 'B+', startText: '0B+' },
  '<10ms': { count: 10, prefix: '<', suffix: 'ms', startText: '<0ms' },
  '30K+': { count: 30, suffix: 'K+', startText: '0K+' },
};
---

<section class="section-pad">
  <div class="container-shell">
    <div class="mech-panel-dark mech-corners relative overflow-hidden px-4 py-8 text-white sm:px-10 sm:py-14 lg:px-14">
      <div class="hatch-overlay-dark pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <BrandWatermark class="-right-10 bottom-[-20%] opacity-[0.14] sm:-right-4" />
      <div class="relative grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:gap-10">
        <div class="section-intro">
          <Logo tone="on-dark" class="mb-4 h-10 w-auto sm:mb-5 sm:h-12" />
          <p class="tech-kicker">Performance · telemetry</p>
          <h2 class="mt-3 font-display text-[1.65rem] font-bold tracking-tight sm:text-4xl lg:text-5xl">
            Our results speak for themselves
          </h2>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-white/65 sm:text-base">
            Empowering traders with consistent, transparent, and lightning-fast trading conditions
            across global markets.
          </p>
          <a href={links.register} class="btn-primary btn-magnetic mt-7 w-full sm:mt-8 sm:w-auto"
            >Start Trading Now</a
          >
        </div>

        <div class="grid gap-0 border border-white/10 sm:grid-cols-3 lg:grid-cols-1">
          {
            performance.map((item, index) => {
              const meta = countMeta[item.value];
              return (
                <div
                  class:list={[
                    'perf-item border-white/10 p-4 sm:p-5',
                    index > 0 && 'border-t sm:border-t-0 sm:border-l lg:border-l-0 lg:border-t',
                  ]}
                >
                  <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/35">
                    Ch.{String(index + 1).padStart(2, '0')}
                  </p>
                  <p
                    class="mt-1 font-display text-3xl font-bold text-signal tabular-nums sm:text-5xl"
                    data-count={meta.count}
                    data-prefix={meta.prefix || ''}
                    data-suffix={meta.suffix || ''}
                    data-decimals={meta.decimals ?? 0}
                  >
                    {meta.startText}
                  </p>
                  <p class="mt-2 text-xs font-semibold uppercase tracking-[0.16em] text-white/55 sm:text-sm">
                    {item.label}
                  </p>
                  <p class="mt-2 text-sm leading-relaxed text-white/65">{item.copy}</p>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>
