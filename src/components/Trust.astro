---
import { brand, links, whyUs } from '../content/site';
import Logo from './Logo.astro';
---

<section id="banking" class="section-pad pt-0">
  <div class="container-shell">
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-10">
      <div class="section-intro">
        <Logo variant="pill" class="mb-4 h-9 w-auto sm:mb-5 sm:h-10" />
        <p class="eyebrow">Why {brand.name}</p>
        <h2 class="headline mt-3">Your funds. Always protected.</h2>
        <p class="lede mt-4">
          Trade with confidence through segregated client accounts, reliable payment rails, and a
          support team built for traders who move fast.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-ink-soft sm:mt-8">
          <li class="flex gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-signal"></span>
            Quick deposits with local providers
          </li>
          <li class="flex gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-signal"></span>
            High-speed withdrawals
          </li>
          <li class="flex gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-signal"></span>
            Global market access with transparent costs
          </li>
        </ul>
        <a href={links.register} class="btn-primary btn-magnetic mt-7 w-full sm:mt-8 sm:w-auto">Create Free Account</a>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 sm:gap-4">
        {
          whyUs.map((item) => (
            <article
              data-spotlight
              class="why-card spotlight-card border border-line bg-white/80 p-4 transition duration-300 hover:-translate-y-1 hover:border-signal/35 hover:shadow-[0_16px_36px_rgba(7,24,34,0.08)] sm:p-5"
            >
              <h3 class="font-display text-base font-bold text-ink sm:text-lg">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
